{
  "schemaVersion": 1,
  "updatedAt": "2026-11-15",
  "scope": "Repository production, testing, deployment, and publication workflows only. No arbitrary compute jobs.",
  "tools": [
    {
      "id": "infocollect.digest",
      "name": "AI情報収集",
      "repository": "gentaron/infocollect",
      "purpose": "AIツールとニュースのダイジェストを更新する",
      "execution": "github-actions-repository-workflow",
      "workflow": "https://github.com/gentaron/infocollect/actions/workflows/daily.yml",
      "input": {
        "type": "none"
      },
      "output": {
        "paths": [
          "docs/data/latest.json",
          "docs/data/archive/",
          "docs/kb/manifest.json"
        ]
      },
      "lastVerifiedRun": "https://github.com/gentaron/infocollect/actions/runs/43570575470"
    },
    {
      "id": "infocollect.kb-rebuild",
      "name": "出典付きKB再生成",
      "repository": "gentaron/infocollect",
      "purpose": "コミット済みの収集アーカイブから静的KBを作り直す",
      "execution": "github-actions-repository-workflow",
      "workflow": "https://github.com/gentaron/infocollect/actions/workflows/kb-backfill.yml",
      "input": {
        "type": "committed-files",
        "paths": [
          "docs/data/archive/"
        ]
      },
      "output": {
        "paths": [
          "docs/kb/manifest.json",
          "docs/kb/shards/"
        ]
      },
      "lastVerifiedCommit": "https://github.com/gentaron/infocollect/commit/b49ac02b34e56d4eebdffff556dfee56678f62ee"
    },
    {
      "id": "vaiz.brief-draft",
      "name": "企画から動画下書き",
      "repository": "gentaron/VAIZ",
      "purpose": "公開企画JSONから動画下書きを作り、公開前にArtifactで止める",
      "execution": "github-actions-repository-workflow",
      "workflow": "https://github.com/gentaron/VAIZ/actions/workflows/brief-draft.yml",
      "input": {
        "type": "reviewed-public-file",
        "pathPattern": "briefs/[A-Za-z0-9._-]+.json",
        "example": "briefs/from-infocollect.json"
      },
      "output": {
        "artifact": "brief-draft-*",
        "files": [
          "out/plan.json",
          "out/final.mp4"
        ],
        "retentionDays": 7
      },
      "lastVerifiedRun": "https://github.com/gentaron/VAIZ/actions/runs/43651319742"
    },
    {
      "id": "presentationgen.brief-import",
      "name": "企画から編集可能なスライド",
      "repository": "gentaron/presentationgen",
      "purpose": "同じcreative-briefをブラウザに読み込み編集可能なスライドを作る",
      "execution": "browser-ui",
      "input": {
        "type": "public-creative-brief",
        "url": "https://github.com/gentaron/VAIZ/blob/main/briefs/from-infocollect.json"
      },
      "output": {
        "type": "editable-slides"
      },
      "lastVerifiedCI": "https://github.com/gentaron/presentationgen/actions/runs/43651855068",
      "runtimeVerification": "pending"
    },
    {
      "id": "qaiz.market-overview",
      "name": "市場地形の公開概要",
      "repository": "gentaron/QAIZ",
      "purpose": "地域・セクター・レジームの観測値を渡す",
      "execution": "cloudflare-worker-api",
      "input": {
        "type": "none",
        "endpoint": "GET /api/overview"
      },
      "output": {
        "type": "market-overview",
        "consumer": "genesisvault.finance-pulse"
      },
      "runtimeVerification": "pending; endpoint base URL is configured in consumer"
    },
    {
      "id": "genesisvault.finance-pulse",
      "name": "公開市場から記事の材料を作る",
      "repository": "gentaron/genesisvault",
      "purpose": "QAIZの市場概要を市場記号と記事ブリーフへ変換する",
      "execution": "github-actions-repository-workflow",
      "workflow": "https://github.com/gentaron/genesisvault/actions/workflows/daily-post.yml",
      "input": {
        "type": "qaiz-market-overview",
        "source": "GET /api/overview",
        "configuration": "QAIZ_BASE_URL"
      },
      "output": {
        "paths": [
          "data/finance-pulse.json",
          "src/content/posts/"
        ],
        "handoff": "market.* → theme selection"
      },
      "runtimeVerification": "CI pending; runtime requires QAIZ_BASE_URL"
    },
    {
      "id": "edu.wiki-canon",
      "name": "EDU世界設定の正典",
      "repository": "gentaron/edu",
      "purpose": "SF世界のWikiエントリを参照する",
      "execution": "public-read-api",
      "input": {
        "type": "none"
      },
      "output": {
        "endpoint": "GET /api/integrations/wiki-index",
        "fields": [
          "id",
          "name",
          "nameEn",
          "category",
          "url"
        ],
        "classification": "fictional"
      },
      "runtimeVerification": "CI passed; deployed endpoint not yet verified"
    },
    {
      "id": "infocollect.edu-wiki-sync",
      "name": "EDU公開Wiki索引の同期",
      "repository": "gentaron/infocollect",
      "purpose": "EDUの公開ページ索引を架空世界専用のKBに保存する",
      "execution": "github-actions-repository-workflow",
      "workflow": "https://github.com/gentaron/infocollect/actions/workflows/daily.yml",
      "input": {
        "type": "edu-public-wiki-index",
        "endpoint": "GET /api/integrations/wiki-index"
      },
      "output": {
        "path": "docs/kb/fiction/edu.json"
      },
      "runtimeVerification": "pending deployment and scheduled run"
    }
  ],
  "network": "ecosystem/registry.json"
}
