    "take": 3,
    "minStars": 100,
    "activeWithinDays": 14,
    "newRepoWindowDays": 120,
    "queries": [
      "topic:ai pushed:>={active} stars:>={minStars}",
      "topic:llm pushed:>={active} stars:>={minStars}",
      "topic:ai-agents pushed:>={active} stars:>={minStars}",
      "topic:generative-ai pushed:>={active} stars:>={minStars}",
      "topic:rag pushed:>={active} stars:>={minStars}",
      "topic:mcp pushed:>={active} stars:>={minStars}",
      "topic:agent created:>={recent} stars:>=50",
      "llm OR agent OR \"ai tool\" in:name,description created:>={recent} stars:>=100"
    ],
