{
  "name": "infocollect",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Daily AI tools & news collector with an installable PWA front-end",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "collect": "node scripts/collect.mjs",
    "blog": "node scripts/blog/generate.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "pack": "node scripts/pack.mjs",
    "serve": "node scripts/serve.mjs",
    "export:brief": "node scripts/export-brief.mjs",
    "test:brief": "node --test scripts/export-brief.test.mjs",
    "kb:build": "node scripts/build-kb.mjs",
    "kb:test": "node --test scripts/build-kb.test.mjs",
    "fleet:check": "node scripts/validate-hyperfleet-catalog.mjs && node --test scripts/validate-hyperfleet-catalog.test.mjs",
    "fleet:plan": "node scripts/hyperfleet-free-stack.mjs --repo infocollect"
  },
  "license": "MIT"
}
