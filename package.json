{
  "name": "infocollect",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Daily AI tools & news collector with an installable PWA front-end",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "collect": "node scripts/collect.mjs",
    "blog": "node scripts/blog/generate.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "pack": "node scripts/pack.mjs",
    "serve": "node scripts/serve.mjs",
    "kb": "node scripts/kb/ingest.mjs",
    "kb:backfill": "node scripts/kb/ingest.mjs --backfill",
    "kb:query": "node scripts/kb/query.mjs",
    "mcp": "node scripts/mcp/server.mjs",
    "test": "node scripts/selftest.mjs",
    "slides": "node scripts/slides/build.mjs",
    "harness": "node scripts/harness/status.mjs",
    "task": "node scripts/harness/task.mjs",
    "forge": "node forge/forge.mjs",
    "test:forge": "node forge/test.mjs",
    "ecosystem": "node scripts/ecosystem/propagate.mjs",
    "ecosystem:map": "node scripts/ecosystem/propagate.mjs --map"
  },
  "license": "MIT",
  "bin": {
    "forge": "forge/forge.mjs",
    "infocollect-kb": "scripts/mcp/server.mjs"
  }
}
